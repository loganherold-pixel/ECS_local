{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_ECS_DISPERSED_CAMPING_LAYER": "true",
        "EXPO_PUBLIC_ECS_ESTABLISHED_CAMPSITES_LAYER": "true",
        "EXPO_PUBLIC_ECS_ROUTE_GEOMETRY_VIEWPORT_OVERLAY": "true"
      }
    },
    "fieldtest": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "fieldtest",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ECS_FIELD_TEST_BUILD": "true",
        "EXPO_PUBLIC_ECS_BUILD_PROFILE": "fieldtest",
        "ECS_REQUIRE_MAPBOX_DOWNLOADS_TOKEN": "true",
        "EXPO_PUBLIC_ECS_MISSION_COMMAND": "true",
        "EXPO_PUBLIC_ECS_DISPERSED_CAMPING_LAYER": "true",
        "EXPO_PUBLIC_ECS_ESTABLISHED_CAMPSITES_LAYER": "true",
        "EXPO_PUBLIC_ECS_ROUTE_GEOMETRY_VIEWPORT_OVERLAY": "true"
      }
    },
    "campops-preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "campops-preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_ECS_DISPERSED_CAMPING_LAYER": "true",
        "EXPO_PUBLIC_ECS_ESTABLISHED_CAMPSITES_LAYER": "true",
        "EXPO_PUBLIC_ECS_ROUTE_GEOMETRY_VIEWPORT_OVERLAY": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ECS_MISSION_COMMAND": "false",
        "ECS_REQUIRE_MAPBOX_DOWNLOADS_TOKEN": "true",
        "EXPO_PUBLIC_ECS_ROUTE_GEOMETRY_VIEWPORT_OVERLAY": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
